datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String                @id @default(uuid())
  username        String                @unique
  passphraseHash  String?               // SHA-256 hash of the 5-word passphrase (optional for legacy seed users)
  role            String                @default("USER")
  avatar          String
  walletBalance   Float                 @default(1000.00)
  reputationPoints Float                @default(100.00) // Reputation for consensus
  trades          Trade[]
  holdings        Holding[]
  transactions    Transaction[]
  comments        Comment[]
  commentVotes    CommentVote[]
  copiedRelations CopyTradingRelation[] @relation("CopiedRelations")
  ledRelations    CopyTradingRelation[] @relation("LedRelations")
  sessions        Session[]
  limitOrders     LimitOrder[]          // For virtual P2P matching
  redemptions     CouponRedemption[]    // For rewards shop
  notifications   Notification[]        // For user alerts/notifications
  achievements    Achievement[]         // For user achievements
  stats           UserStats?            // For gamification stats
  createdAt       DateTime              @default(now())
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}


model Market {
  id                String    @id @default(uuid())
  title             String
  description       String
  category          String    // IPL, Finance, Politics, Bollywood
  image             String
  endDate           DateTime
  resolved          Boolean   @default(false)
  outcome           String?   // "YES" or "NO" or null
  liquidity         Float     @default(100.0) // b parameter
  yesShares         Float     @default(0.0)   // q1
  noShares          Float     @default(0.0)   // q2
  volume            Float     @default(0.0)   // Total traded INR volume
  aiConfidence      Float     @default(50.0)
  marketSentiment   String    @default("Neutral") // Bullish, Bearish, Neutral, Volatile
  trendingNarrative String    @default("Even odds trade")
  trades            Trade[]
  holdings          Holding[]
  comments          Comment[]
  limitOrders       LimitOrder[]          // For virtual P2P matching
  createdAt         DateTime  @default(now())
}

model Trade {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id])
  side      String   // "YES" or "NO"
  amount    Float    // INR cash amount
  shares    Float    // Shares bought
  price     Float    // Average price per share
  createdAt DateTime @default(now())
}

model Holding {
  id        String @id @default(uuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  marketId  String
  market    Market @relation(fields: [marketId], references: [id])
  yesShares Float  @default(0.0)
  noShares  Float  @default(0.0)

  @@unique([userId, marketId])
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "DEPOSIT", "WITHDRAW", "BUY_YES", "BUY_NO", "SETTLEMENT"
  amount    Float
  status    String   // "SUCCESS", "PENDING", "FAILED"
  createdAt DateTime @default(now())
}

model Comment {
  id        String        @id @default(uuid())
  marketId  String
  market    Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  parentId  String?
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  votes     CommentVote[]
  createdAt DateTime      @default(now())
}

model CommentVote {
  id        String   @id @default(uuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int      // 1 for upvote, -1 for downvote
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model CopyTradingRelation {
  id        String   @id @default(uuid())
  copierId  String
  copier    User     @relation("CopiedRelations", fields: [copierId], references: [id], onDelete: Cascade)
  leaderId  String
  leader    User     @relation("LedRelations", fields: [leaderId], references: [id], onDelete: Cascade)
  allocated Float
  profits   Float    @default(0.0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model LimitOrder {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])
  side       String   // "YES" or "NO"
  orderType  String   // "BUY" or "SELL"
  price      Float    // Virtual tokens per share (0.01 - 0.99)
  shares     Float    
  filled     Float    @default(0.0)
  status     String   // "PENDING", "PARTIAL", "FILLED", "CANCELLED"
  createdAt  DateTime @default(now())
}

model CouponRedemption {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  rewardCode   String   // e.g. "AMZN-200-OFF"
  voucherPin   String   // The active brand voucher pin
  tokenCost    Float    // Coins spent on redemption
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "TRADE", "SETTLEMENT", "MARKET_CLOSING", "COPY_TRADE"
  title     String
  body      String
  read      Boolean  @default(false)
  metadata  String?  // JSON string containing marketId, tradeId, etc.
  createdAt DateTime @default(now())
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "FIRST_TRADE", "STREAK_10", "PROFIT_10K", "IPL_MASTER"
  unlockedAt  DateTime @default(now())
}

model UserStats {
  userId               String    @id
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak        Int       @default(0)
  longestStreak        Int       @default(0)
  totalPredictions     Int       @default(0)
  correctPredictions   Int       @default(0)
  xp                   Int       @default(0)
  level                Int       @default(1)
  lastPredictionDate   String?   // YYYY-MM-DD
  lastFreeClaimedAt    DateTime? // Daily free prediction token credit timestamp
}
